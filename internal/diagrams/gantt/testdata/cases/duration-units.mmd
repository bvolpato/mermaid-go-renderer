gantt
  dateFormat YYYY-MM-DD HH:mm:ss
  axisFormat %m-%d %H:%M
  Start :s, 2024-01-31 23:59:59, 500ms
  Seconds :a, after s, 90s
  Minutes :b, after a, 45m
  Hours :c, after b, 36h
  Days :d, after c, 1.5d
  Weeks :e, after d, 2w
  Months :f, after e, 1M
  Fraction month :g, after f, 0.5M
  Years :h, after s, 1y
  Fraction hours :after s, 2.25h
